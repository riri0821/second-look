# Optional. Without these, Second Look still runs its own heuristic checks.
# Copy this file to .env and fill in keys.
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_KEY=
PORT=3123
# Shown on the privacy policy page (/privacy)
CONTACT_EMAIL=
# Database for scam reports and feedback. Leave empty to turn those buttons off.
DATABASE_URL=
# Long random secret used to make the one-way reporter code
REPORT_SECRET=
